# Copy to .env and fill in. Never commit .env.
JARVIS_SHARED_SECRET=change-me
JARVIS_DB_PATH=data/jarvis.db
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8765
JARVIS_TZ=Europe/Berlin
# Extra packages to ignore as noise, comma-separated
JARVIS_NOISE_APPS=

ANTHROPIC_API_KEY=
TELEGRAM_BOT_TOKEN=
# Agent
JARVIS_MODEL=claude-sonnet-5-5
JARVIS_SUMMARY_MODEL=claude-haiku-5-5
JARVIS_EFFORT=medium
JARVIS_HEARTBEAT_MIN=120
JARVIS_QUIET_HOURS=0-8
